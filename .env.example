# Fichier FACULTATIF : Capsule Studio fonctionne sans .env.
# La clé Fish Audio, les générations payantes, les budgets, la limite quotidienne et le réseau local
# se règlent dans l'application (Réglages). Les réglages enregistrés dans l'application ont priorité sur ce fichier.
# Pour l'utiliser : copier ce fichier en ".env" et décommenter les lignes voulues.

# Port local (l'application n'écoute que sur 127.0.0.1)
# PORT=8746

# Dossier des données (base JSON + prises audio). Par défaut : %APPDATA%\CapsuleStudio sous Windows,
# ~/Library/Application Support/CapsuleStudio sous macOS, ~/.local/share/capsule-studio sous Linux.
# DATA_DIR=./data

# Étiquette affichée à côté du nom et dans le titre de la fenêtre (utile pour une copie de développement)
# APP_LABEL=Dev
# Adresse ouverte par le lanceur Windows : "localhost" sépare la session de celle d'une autre copie (127.0.0.1)
# BROWSER_HOST=127.0.0.1

# Valeurs par défaut des réglages (modifiables ensuite dans l'application)
# FISH_API_KEY=
# ALLOW_PAID_GENERATION=false
# PAID_BUDGET_TOTAL_USD=
# PAID_MAX_PER_REQUEST_USD=
# ENABLE_DRAMA3=false
# MAX_GENERATIONS_PER_DAY=999
# FREE_OFFER_END_DATE=2026-11-30
# LAN=false
# Port HTTPS du réseau local (PORT + 100 par défaut)
# LAN_PORT=8846

# Fuseau horaire des quotas quotidiens et de la fin de l'offre gratuite
# FREE_OFFER_TIMEZONE=Europe/Paris

# Taille maximale d'un segment (octets UTF-8)
# MAX_BYTES_PER_SEGMENT=5000

# Jeton agent fixe (sinon : Réglages → Accès agent)
# CAPSULE_AGENT_TOKEN=
